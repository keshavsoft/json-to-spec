[
  {
    "tagName": "div",
    "attributes": {
      "class": "ksform border rounded-3 shadow-sm bg-white overflow-hidden"
    },
    "children": [
      {
        "tagName": "div",
        "attributes": {
          "class": "bg-body-secondary p-3 border-bottom d-flex justify-content-between align-items-center"
        },
        "children": [
          {
            "tagName": "span",
            "textContent": "${meta.formTitle}",
            "attributes": { "class": "fw-bold fs-6 text-dark" }
          },
          {
            "tagName": "span",
            "textContent": "${meta.formBadge}",
            "attributes": { "class": "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle font-monospace small" }
          }
        ]
      },
      {
        "tagName": "div",
        "attributes": { "class": "p-4" },
        "children": [
          {
            "tagName": "div",
            "textContent": "${meta.formLead}",
            "attributes": { "class": "alert alert-warning border small mb-4" }
          },
          {
            "tagName": "div",
            "textContent": "${meta.formHint}",
            "attributes": { "class": "small text-muted mb-3" }
          },
          {
            "tagName": "div",
            "attributes": { "class": "row g-3" },
            "children": [
              {
                "jsonToSpec": {
                  "operation": "iterate",
                  "source": "columns",
                  "filter": { "isVisible": true },
                  "template": {
                    "tagName": "div",
                    "attributes": { "class": "${colClass}" },
                    "children": [
                      {
                        "tagName": "label",
                        "textContent": "${title}",
                        "attributes": { "class": "form-label fw-semibold text-secondary small" }
                      },
                      {
                        "tagName": "select",
                        "attributes": {
                          "name": "${field}",
                          "class": "form-select",
                          "size": "${size}"
                        },
                        "properties": { "multiple": true },
                        "children": [
                          {
                            "jsonToSpec": {
                              "operation": "iterate",
                              "source": "options",
                              "template": {
                                "tagName": "option",
                                "textContent": "${text}",
                                "attributes": { "value": "${value}" },
                                "properties": { "selected": "${selected}" }
                              }
                            }
                          }
                        ]
                      },
                      {
                        "tagName": "small",
                        "textContent": "${helpText}",
                        "attributes": { "class": "text-muted d-block mt-1" }
                      }
                    ]
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "tagName": "div",
        "attributes": {
          "class": "bg-light p-3 border-top d-flex justify-content-end gap-2"
        },
        "children": [
          {
            "tagName": "button",
            "textContent": "Reset",
            "attributes": {
              "type": "button",
              "class": "btn btn-outline-secondary",
              "data-action": "cancel",
              "data-action-type": "click"
            }
          },
          {
            "tagName": "button",
            "textContent": "Save Multi Selects",
            "attributes": {
              "type": "button",
              "class": "btn btn-warning",
              "data-action": "save",
              "data-action-type": "click"
            }
          }
        ]
      }
    ]
  }
]
