  {
                "tagName": "div",
                "attributes": {
                    "class": "container row g-3 "
                },
                "jsonToSpec": {
                    "operation": "iterate",
                    "source": "columns",
                    "filter": {
                        "isVisible": true
                    },
                    "template": {
                        "tagName": "div",
                        "attributes": {
                            "class": "${colClass}"
                        },
                        "children": [
                            {
                                "tagName": "label",
                                "textContent": "${title}",
                                "attributes": {
                                    "class": "form-label fw-semibold text-secondary small"
                                }
                            },
                            {
                                "tagName": "input",
                                "attributes": {
                                    "name": "${field}",
                                    "type": "${inputType}",
                                    "placeholder": "${placeholder}",
                                    "class": "form-control"
                                }
                            }
                        ]
                    }
                },
                "children": []
            }