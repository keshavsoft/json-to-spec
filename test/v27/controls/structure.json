[
  {
    "tagName": "div",
    "attributes": {
      "class": "ksform border rounded-3 shadow-sm bg-white overflow-hidden"
    },
    "children": [
      {
        "tagName": "div",
        "attributes": {
          "class": "bg-body-secondary p-3 border-bottom d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3"
        },
        "children": [
          {
            "tagName": "div",
            "children": [
              {
                "tagName": "span",
                "textContent": "${header.title}",
                "attributes": {
                  "class": "fw-bold fs-6 text-dark d-block"
                }
              },
              {
                "tagName": "small",
                "textContent": "${header.subtitle}",
                "attributes": {
                  "class": "text-muted"
                }
              }
            ]
          },
          {
            "tagName": "div",
            "attributes": {
              "class": "d-flex flex-wrap gap-2 align-items-center"
            },
            "children": [
              {
                "tagName": "span",
                "textContent": "${summary.controlCount} controls",
                "attributes": {
                  "class": "badge bg-primary-subtle text-primary border border-primary-subtle font-monospace"
                }
              },
              {
                "jsonToSpec": {
                  "operation": "iterate",
                  "source": "summary.families",
                  "template": {
                    "tagName": "span",
                    "textContent": "${item}",
                    "attributes": {
                      "class": "badge bg-light text-secondary border text-uppercase"
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "tagName": "div",
        "attributes": {
          "class": "p-4"
        },
        "children": [
          {
            "tagName": "div",
            "attributes": {
              "class": "alert alert-info border small mb-4"
            },
            "children": [
              {
                "tagName": "div",
                "textContent": "This fixture showcases mixed control families while keeping structure.json and data.json separated. Click Save Voucher to inspect the extracted payload for text inputs, selects, multi-selects, radios, checkboxes, and textarea."
              }
            ]
          },
          {
            "tagName": "div",
            "attributes": {
              "class": "row g-3"
            },
            "children": [
              {
                "jsonToSpec": {
                  "operation": "iterate",
                  "source": "columns",
                  "filter": {
                    "control": "input"
                  },
                  "template": {
                    "tagName": "div",
                    "attributes": {
                      "class": "${colClass}"
                    },
                    "children": [
                      {
                        "tagName": "label",
                        "textContent": "${title}",
                        "attributes": {
                          "class": "form-label fw-semibold text-secondary small"
                        }
                      },
                      {
                        "tagName": "input",
                        "attributes": {
                          "name": "${field}",
                          "type": "${inputType}",
                          "placeholder": "${placeholder}",
                          "class": "form-control"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "jsonToSpec": {
                  "operation": "iterate",
                  "source": "columns",
                  "filter": {
                    "control": "select"
                  },
                  "template": {
                    "tagName": "div",
                    "attributes": {
                      "class": "${colClass}"
                    },
                    "children": [
                      {
                        "tagName": "label",
                        "textContent": "${title}",
                        "attributes": {
                          "class": "form-label fw-semibold text-secondary small"
                        }
                      },
                      {
                        "tagName": "select",
                        "attributes": {
                          "name": "${field}",
                          "class": "form-select"
                        },
                        "children": [
                          {
                            "tagName": "option",
                            "textContent": "${placeholder}",
                            "attributes": {
                              "value": ""
                            }
                          },
                          {
                            "jsonToSpec": {
                              "operation": "iterate",
                              "source": "options",
                              "template": {
                                "tagName": "option",
                                "textContent": "${text}",
                                "attributes": {
                                  "value": "${value}"
                                },
                                "properties": {
                                  "selected": "${selected}"
                                }
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "jsonToSpec": {
                  "operation": "iterate",
                  "source": "columns",
                  "filter": {
                    "control": "multiselect"
                  },
                  "template": {
                    "tagName": "div",
                    "attributes": {
                      "class": "${colClass}"
                    },
                    "children": [
                      {
                        "tagName": "label",
                        "textContent": "${title}",
                        "attributes": {
                          "class": "form-label fw-semibold text-secondary small"
                        }
                      },
                      {
                        "tagName": "select",
                        "attributes": {
                          "name": "${field}",
                          "class": "form-select",
                          "size": "${size}"
                        },
                        "properties": {
                          "multiple": true
                        },
                        "children": [
                          {
                            "jsonToSpec": {
                              "operation": "iterate",
                              "source": "options",
                              "template": {
                                "tagName": "option",
                                "textContent": "${text}",
                                "attributes": {
                                  "value": "${value}"
                                },
                                "properties": {
                                  "selected": "${selected}"
                                }
                              }
                            }
                          }
                        ]
                      },
                      {
                        "tagName": "small",
                        "textContent": "${helpText}",
                        "attributes": {
                          "class": "text-muted d-block mt-1"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "jsonToSpec": {
                  "operation": "iterate",
                  "source": "columns",
                  "filter": {
                    "control": "radio"
                  },
                  "template": {
                    "tagName": "div",
                    "attributes": {
                      "class": "${colClass}"
                    },
                    "children": [
                      {
                        "tagName": "label",
                        "textContent": "${title}",
                        "attributes": {
                          "class": "form-label fw-semibold text-secondary small d-block"
                        }
                      },
                      {
                        "tagName": "div",
                        "attributes": {
                          "class": "d-flex flex-wrap gap-3 pt-1"
                        },
                        "children": [
                          {
                            "jsonToSpec": {
                              "operation": "iterate",
                              "source": "options",
                              "template": {
                                "tagName": "label",
                                "attributes": {
                                  "class": "form-check form-check-inline mb-0 d-flex align-items-center gap-2"
                                },
                                "children": [
                                  {
                                    "tagName": "input",
                                    "attributes": {
                                      "type": "radio",
                                      "name": "${field}",
                                      "value": "${value}",
                                      "class": "form-check-input m-0",
                                      "id": "${field}-${value}"
                                    },
                                    "properties": {
                                      "checked": "${checked}"
                                    }
                                  },
                                  {
                                    "tagName": "span",
                                    "textContent": "${text}",
                                    "attributes": {
                                      "class": "form-check-label"
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "jsonToSpec": {
                  "operation": "iterate",
                  "source": "columns",
                  "filter": {
                    "control": "checkboxGroup"
                  },
                  "template": {
                    "tagName": "div",
                    "attributes": {
                      "class": "${colClass}"
                    },
                    "children": [
                      {
                        "tagName": "label",
                        "textContent": "${title}",
                        "attributes": {
                          "class": "form-label fw-semibold text-secondary small d-block"
                        }
                      },
                      {
                        "tagName": "div",
                        "attributes": {
                          "class": "d-flex flex-wrap gap-3 pt-1"
                        },
                        "children": [
                          {
                            "jsonToSpec": {
                              "operation": "iterate",
                              "source": "options",
                              "template": {
                                "tagName": "label",
                                "attributes": {
                                  "class": "form-check mb-0 d-flex align-items-center gap-2"
                                },
                                "children": [
                                  {
                                    "tagName": "input",
                                    "attributes": {
                                      "type": "checkbox",
                                      "name": "${field}",
                                      "value": "${value}",
                                      "class": "form-check-input m-0",
                                      "id": "${field}-${value}"
                                    },
                                    "properties": {
                                      "checked": "${checked}"
                                    }
                                  },
                                  {
                                    "tagName": "span",
                                    "textContent": "${text}",
                                    "attributes": {
                                      "class": "form-check-label"
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "jsonToSpec": {
                  "operation": "iterate",
                  "source": "columns",
                  "filter": {
                    "control": "checkbox"
                  },
                  "template": {
                    "tagName": "div",
                    "attributes": {
                      "class": "${colClass}"
                    },
                    "children": [
                      {
                        "tagName": "label",
                        "textContent": "${title}",
                        "attributes": {
                          "class": "form-label fw-semibold text-secondary small d-block"
                        }
                      },
                      {
                        "tagName": "div",
                        "attributes": {
                          "class": "form-check form-switch mt-1"
                        },
                        "children": [
                          {
                            "tagName": "input",
                            "attributes": {
                              "type": "checkbox",
                              "name": "${field}",
                              "class": "form-check-input",
                              "id": "${field}"
                            },
                            "properties": {
                              "checked": "${checked}"
                            }
                          },
                          {
                            "tagName": "label",
                            "textContent": "${checkboxText}",
                            "attributes": {
                              "class": "form-check-label",
                              "for": "${field}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "jsonToSpec": {
                  "operation": "iterate",
                  "source": "columns",
                  "filter": {
                    "control": "textarea"
                  },
                  "template": {
                    "tagName": "div",
                    "attributes": {
                      "class": "${colClass}"
                    },
                    "children": [
                      {
                        "tagName": "label",
                        "textContent": "${title}",
                        "attributes": {
                          "class": "form-label fw-semibold text-secondary small"
                        }
                      },
                      {
                        "tagName": "input",
                        "attributes": {
                          "name": "${field}",
                          "placeholder": "${placeholder}",
                          "rows": "4",
                          "class": "form-control"
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "tagName": "div",
        "attributes": {
          "class": "bg-light p-3 border-top d-flex justify-content-end gap-2"
        },
        "children": [
          {
            "tagName": "button",
            "textContent": "Reset Form",
            "attributes": {
              "type": "button",
              "class": "btn btn-outline-secondary px-3 py-1.5",
              "data-action": "cancel",
              "data-action-type": "click"
            }
          },
          {
            "tagName": "button",
            "textContent": "Save Voucher",
            "attributes": {
              "type": "button",
              "class": "btn btn-success px-4 py-1.5 fw-semibold",
              "data-action": "save",
              "data-action-type": "click"
            }
          }
        ]
      }
    ]
  }
]
