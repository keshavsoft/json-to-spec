// =============================================================================
// JSON-TO-SPEC v3: FORM STRUCTURE BLUEPRINT (structure.json)
// =============================================================================
// Architecture Rule:
// - Outside jsonToSpec: 100% pure json-to-dom DOM vocabulary.
// - Inside jsonToSpec: 100% pure json-to-spec compiler directives.
// - Zero mixing of keys. Zero compiler traces post-compilation.
// =============================================================================

[
  {
    // -------------------------------------------------------------------------
    // 1. ROOT CONTAINER (Pure json-to-dom DOM node)
    // -------------------------------------------------------------------------
    "tagName": "div",
    "attributes": {
      "class": "ksform border rounded-3 shadow-sm bg-white overflow-hidden"
    },
    "children": [

      // -----------------------------------------------------------------------
      // 2. FORM HEADER (Pure json-to-dom DOM node)
      // -----------------------------------------------------------------------
      {
        "tagName": "div",
        "attributes": {
          "class": "bg-body-secondary p-3 border-bottom d-flex justify-content-between align-items-center"
        },
        "children": [
          {
            "tagName": "span",
            "textContent": "Voucher Entry Form",
            "attributes": { "class": "fw-bold fs-6 text-dark" }
          },
          {
            "tagName": "span",
            "textContent": "v3 jsonToSpec namespace",
            "attributes": {
              "class": "badge bg-primary-subtle text-primary border border-primary-subtle font-monospace small"
            }
          }
        ]
      },

      // -----------------------------------------------------------------------
      // 3. FORM BODY & DYNAMIC COLUMN ITERATION
      // -----------------------------------------------------------------------
      {
        "tagName": "div",
        "attributes": {
          "class": "p-4"
        },
        "children": [
          {
            // The Container: Pure DOM node
            "tagName": "div",
            "attributes": { "class": "row g-3" },

            // THE ISOLATED COMPILER BRAIN (Zero DOM keys at this level!)
            // Everything inside jsonToSpec belongs strictly to json-to-spec.
            "jsonToSpec": {
              "operation": "iterate",             // WHAT TO DO: Loop
              "source": "columns",                // WHERE: data.columns array
              "filter": {                         // FILTER: Skip hidden (e.g. pk)
                "isVisible": true
              },
              // THE TEMPLATE (Pure DOM node to replicate for each column)
              "template": {
                "tagName": "div",
                "attributes": { "class": "col-md-6" },
                "children": [
                  {
                    "tagName": "label",
                    "textContent": "${title}",
                    "attributes": {
                      "class": "form-label fw-semibold text-secondary small"
                    }
                  },
                  {
                    "tagName": "input",
                    "attributes": {
                      "name": "${field}",
                      "type": "${inputType}",
                      "placeholder": "Enter ${title}...",
                      "class": "form-control"
                    }
                  }
                ]
              }
            }
          }
        ]
      },

      // -----------------------------------------------------------------------
      // 4. FORM FOOTER & ACTION BUTTONS (Pure json-to-dom DOM node)
      // -----------------------------------------------------------------------
      // Pinned to card footer. Sibling of the body.
      // Uses data-action to hook into json-to-dom v27 listeners.
      {
        "tagName": "div",
        "attributes": {
          "class": "bg-light p-3 border-top d-flex justify-content-end gap-2"
        },
        "children": [
          {
            "tagName": "button",
            "textContent": "Reset Form",
            "attributes": {
              "type": "button",
              "class": "btn btn-outline-secondary px-3 py-1.5",
              "data-action": "cancel",
              "data-action-type": "click"
            }
          },
          {
            "tagName": "button",
            "textContent": "Save Voucher",
            "attributes": {
              "type": "button",
              "class": "btn btn-success px-4 py-1.5 fw-semibold",
              "data-action": "save",
              "data-action-type": "click"
            }
          }
        ]
      }

    ]
  }
]
