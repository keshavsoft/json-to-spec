{
    "tagName": "table",
    "attributes": {
        "class": "table table-hover table-striped mb-0"
    },
    "children": [
        {
            "tagName": "thead",
            "children": [
                {
                    "tagName": "tr",
                    "jsonToSpec": {
                        "operation": "loopCollection",
                        "source": "columns",
                        "template": {
                            "tagName": "th",
                            "textContent": "${title}"
                        }
                    },
                    "children": []
                }
            ]
        },
        {
            "tagName": "tbody",
            "jsonToSpec": {
                "operation": "loopCollection",
                "source": "data",
                "template": {
                    "tagName": "tr",
                    "jsonToSpec": {
                        "operation": "loopObject",
                        "source": "data",
                        "template": {
                            "tagName": "td",
                            "textContent": "${value}"
                        }
                    },
                    "children": []
                }
            },
            "children": []
        }
    ]
}