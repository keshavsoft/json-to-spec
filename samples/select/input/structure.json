{
    "tagName": "table",
    "attributes": {
        "class": "table"
    },
    "children": [
        {
            "tagName": "thead",
            "children": [
                {
                    "tagName": "tr",
                    "children": [
                        {
                            "tagName": "th",
                            "textContent": "Name"
                        },
                        {
                            "tagName": "th",
                            "textContent": "Amount"
                        }
                    ]
                }
            ]
        },
        {
            "tagName": "tbody",
            "jsonToSpec": {
                "operation": "iterate",
                "source": "data",
                "template": {
                    "tagName": "tr",
                    "children": [
                        {
                            "tagName": "td",
                            "textContent": "${LedgerName}"
                        },
                        {
                            "tagName": "td",
                            "textContent": "${Amount}"
                        }
                    ]
                }
            },
            "children": []
        }
    ]
}